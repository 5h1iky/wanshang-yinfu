<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置（2026-10-02，真机验证发现的缺陷）。

    背景（实测证据，不是推测）：视频预加载与缓存走的是 AndroidVideoCache 的**本地回环代理**
    （http://127.0.0.1:<随机端口>/...），而 targetSdk 28+ 默认**禁止一切明文 HTTP**，
    Android 也**没有**给回环地址任何豁免。实测日志：

        预加载失败 #0：IOException Cleartext HTTP traffic to 127.0.0.1 not permitted

    后果：预加载 100% 失败并被丢进黑名单，video-cache 目录与 AndroidVideoCache.db
    从未被创建过 —— 也就是说**整个视频缓存子系统从上线起就是死的**：
    每滑一条都要重新走网络拉流（首帧更慢、更费流量），而"缓存上限/清缓存"这些设置
    其实一直没有作用对象。

    修法：只为一个域开明文 —— 127.0.0.1（以及等价的 localhost）。
    ⚠️ 这是**唯一**开明文的地方，别的主机仍然全禁；代理也只绑在回环上，不对外暴露。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
