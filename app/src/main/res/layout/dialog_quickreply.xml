<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷回复内容编辑面板（软件内问题 ③b，2026-10-01）。
  4 个槽位各一行（显示当前文案），点某行 → 弹单行输入框改；另有「恢复默认」。
  视觉沿用 DyDialog：深色圆角卡 + bg_settings_row 行 + 胶囊按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/s5"
    android:paddingEnd="@dimen/s5"
    android:paddingTop="@dimen/s4"
    android:paddingBottom="@dimen/s4">

    <TextView
        android:id="@+id/qre_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/quick_reply_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/t_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/qre_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:text="@string/quick_reply_hint"
        android:textColor="@color/text_faint"
        android:textSize="@dimen/t_caption" />

    <TextView
        android:id="@+id/qre1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s3"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ctrl_min"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s4"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/t_body" />

    <TextView
        android:id="@+id/qre2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ctrl_min"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s4"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/t_body" />

    <TextView
        android:id="@+id/qre3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ctrl_min"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s4"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/t_body" />

    <TextView
        android:id="@+id/qre4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ctrl_min"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s4"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/t_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s4"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qre_reset"
            style="@style/DyDialogButton.Ghost"
            android:layout_marginEnd="@dimen/s3"
            android:text="@string/quick_reply_restore" />

        <TextView
            android:id="@+id/qre_done"
            style="@style/DyDialogButton.Primary"
            android:text="完成" />
    </LinearLayout>
</LinearLayout>
