<?xml version="1.0" encoding="utf-8"?>
<!--
  手表主屏 = 导航根（方案 §10）。
  旧版是 5 条全宽按钮，纵向约 400dp，186dpi 圆屏可用高只有约 275dp —— 必然溢出。
  现在：一级功能做成 2×2 图标卡，次要动作压成底部一行；整体再套 ScrollView 兜底，
  这样即使某块表更矮也只是能滚，不会把「退出」挤出屏幕。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/s3"
        android:paddingBottom="@dimen/s4">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s2"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/t_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s1"
            android:text="@string/hello_m0"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/t_caption" />

        <!-- 一级功能：刷视频 / 聊天 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s4"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_feed"
                style="@style/EntryCard"
                android:layout_marginRight="@dimen/s3">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_play" />

                <TextView style="@style/EntryCardLabel" android:text="刷视频" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_chat"
                style="@style/EntryCard">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_chat" />

                <TextView style="@style/EntryCardLabel" android:text="聊天" />
            </LinearLayout>
        </LinearLayout>

        <!--
          一级功能：我的 / 设置
          （登录从一级卡降为底部状态行——它是低频操作，让位给「我的」；
           且状态行能直接显示"已登录/需重登/未登录"，比一个图标更说明问题）
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s3"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_mine"
                style="@style/EntryCard"
                android:layout_marginRight="@dimen/s3">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_heart" />

                <TextView style="@style/EntryCardLabel" android:text="我的" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                style="@style/EntryCard">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_gear" />

                <TextView style="@style/EntryCardLabel" android:text="设置" />
            </LinearLayout>
        </LinearLayout>

        <!--
          次要动作：登录状态 + 退出。
          原先登录占一格一级位，但它低频且状态多变（已登录/需重登/未登录），
          做成细行既能显示状态又不占一级位。退出必须显式存在（方案 §10：手表无手势无按键）。
        -->
        <LinearLayout
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ctrl_min"
            android:layout_marginTop="@dimen/s3"
            android:background="@drawable/bg_settings_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/s4">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_avatar" />

            <TextView
                android:id="@+id/lbl_login"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/s3"
                android:layout_weight="1"
                android:text="登录"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/t_body" />

            <TextView
                android:id="@+id/lbl_login_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/t_caption" />
        </LinearLayout>

        <!--
          次要动作：只留退出。原先这里还有个「诊断」，但诊断已经收进设置页
          （且比主屏版更全，多了缩放/屏形/边距/看过条数），同一功能两个入口白占一格一级位。
          手表无手势无按键，退出必须显式存在（方案 §10）。
        -->
        <Button
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ctrl_min"
            android:layout_marginTop="@dimen/s3"
            android:background="@drawable/bg_settings_row"
            android:text="退出应用"
            android:textColor="@color/danger"
            android:textSize="@dimen/t_body" />

        <!-- 版本行由代码写入（读 BuildConfig.VERSION_NAME），不再手写——
             手写值必然随发版漂移（v0.1.0 曾一直挂在 0.2.0 的包上） -->
        <TextView
            android:id="@+id/tv_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s3"
            android:textColor="@color/text_faint"
            android:textSize="@dimen/t_caption" />
    </LinearLayout>
</ScrollView>
