<?xml version="1.0" encoding="utf-8"?>
<!--
  手表主屏 = 导航根（方案 §10）。
  旧版是 5 条全宽按钮，纵向约 400dp，186dpi 圆屏可用高只有约 275dp —— 必然溢出。
  现在：一级功能做成 2×2 图标卡，次要动作压成底部一行；整体再套 ScrollView 兜底，
  这样即使某块表更矮也只是能滚，不会把「退出」挤出屏幕。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/s3"
        android:paddingBottom="@dimen/s4">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s2"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/t_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s1"
            android:text="@string/hello_m0"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/t_caption" />

        <!-- 一级功能：刷视频 / 聊天 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s4"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_feed"
                style="@style/EntryCard"
                android:layout_marginRight="@dimen/s3">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_play" />

                <TextView style="@style/EntryCardLabel" android:text="刷视频" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_chat"
                style="@style/EntryCard">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_chat" />

                <TextView style="@style/EntryCardLabel" android:text="聊天" />
            </LinearLayout>
        </LinearLayout>

        <!-- 一级功能：登录 / 设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s3"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_login"
                style="@style/EntryCard"
                android:layout_marginRight="@dimen/s3">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_avatar" />

                <TextView
                    android:id="@+id/lbl_login"
                    style="@style/EntryCardLabel"
                    android:text="登录" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                style="@style/EntryCard">

                <ImageView style="@style/EntryCardIcon" android:src="@drawable/ic_gear" />

                <TextView style="@style/EntryCardLabel" android:text="设置" />
            </LinearLayout>
        </LinearLayout>

        <!--
          次要动作：只留退出。原先这里还有个「诊断」，但诊断已经收进设置页
          （且比主屏版更全，多了缩放/屏形/边距/看过条数），同一功能两个入口白占一格一级位。
          手表无手势无按键，退出必须显式存在（方案 §10）。
        -->
        <Button
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ctrl_min"
            android:layout_marginTop="@dimen/s3"
            android:background="@drawable/bg_settings_row"
            android:text="退出应用"
            android:textColor="@color/danger"
            android:textSize="@dimen/t_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s3"
            android:text="v0.1.0 · 与官方无关 · 风险自负"
            android:textColor="@color/text_faint"
            android:textSize="@dimen/t_caption" />
    </LinearLayout>
</ScrollView>
