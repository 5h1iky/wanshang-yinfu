<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_base">
    <ImageView android:id="@+id/iv_live_cover" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop" />
    <xyz.doikki.videoplayer.player.VideoView android:id="@+id/live_player"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/live_touch" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clickable="true" android:focusable="true" />
    <ProgressBar android:id="@+id/live_progress" android:layout_width="@dimen/spinner_size"
        android:layout_height="@dimen/spinner_size" android:layout_gravity="center"
        android:indeterminateTint="@color/spinner" />
    <LinearLayout android:id="@+id/live_title_bar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="top"
        android:orientation="vertical" android:background="@color/scrim"
        android:paddingHorizontal="@dimen/s4" android:paddingVertical="@dimen/s2">
        <TextView android:id="@+id/tv_live_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/text_primary" android:textSize="@dimen/t_body"
            android:textStyle="bold" />
        <TextView android:id="@+id/tv_live_owner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/text_secondary" android:textSize="@dimen/t_caption" />
    </LinearLayout>
    <TextView android:id="@+id/tv_live_hint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginBottom="96dp" android:background="@color/scrim"
        android:gravity="center" android:paddingHorizontal="@dimen/s4"
        android:paddingVertical="@dimen/s2" android:textColor="@color/text_secondary"
        android:textSize="@dimen/t_caption" />
    <LinearLayout android:id="@+id/live_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/s2"
        android:background="@color/bg_surface" android:orientation="vertical"
        android:paddingHorizontal="@dimen/s3" android:paddingVertical="@dimen/s2">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_live_quality" android:layout_width="0dp"
                android:layout_height="@dimen/ctrl_min" android:layout_weight="1.4"
                android:background="@drawable/bg_settings_row" app:backgroundTint="@null"
                android:text="流畅" android:textColor="@color/text_primary" android:textSize="@dimen/t_caption" />
            <Button android:id="@+id/btn_live_fullscreen" android:layout_width="0dp"
                android:layout_height="@dimen/ctrl_min" android:layout_weight="1"
                android:layout_marginStart="@dimen/s2" android:background="@drawable/bg_settings_row"
                app:backgroundTint="@null" android:text="全屏" android:textColor="@color/text_primary"
                android:textSize="@dimen/t_caption" />
            <Button android:id="@+id/btn_live_rotate" android:layout_width="0dp"
                android:layout_height="@dimen/ctrl_min" android:layout_weight="1"
                android:layout_marginStart="@dimen/s2" android:background="@drawable/bg_settings_row"
                app:backgroundTint="@null" android:text="旋转" android:textColor="@color/text_primary"
                android:textSize="@dimen/t_caption" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s2" android:orientation="horizontal">
            <Button android:id="@+id/btn_live_reset" android:layout_width="0dp"
                android:layout_height="@dimen/ctrl_min" android:layout_weight="1"
                android:background="@drawable/bg_settings_row" app:backgroundTint="@null"
                android:text="复位" android:textColor="@color/text_primary" android:textSize="@dimen/t_caption" />
            <Button android:id="@+id/btn_live_reconnect" android:layout_width="0dp"
                android:layout_height="@dimen/ctrl_min" android:layout_weight="1"
                android:layout_marginStart="@dimen/s2" android:background="@drawable/bg_settings_row"
                app:backgroundTint="@null" android:text="重连" android:textColor="@color/text_primary"
                android:textSize="@dimen/t_caption" />
            <Button android:id="@+id/btn_live_exit" android:layout_width="0dp"
                android:layout_height="@dimen/ctrl_min" android:layout_weight="1"
                android:layout_marginStart="@dimen/s2" android:background="@drawable/bg_settings_row"
                app:backgroundTint="@null" android:text="退出" android:textColor="@color/text_primary"
                android:textSize="@dimen/t_caption" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
