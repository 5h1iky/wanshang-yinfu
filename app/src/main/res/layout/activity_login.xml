<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页（架构 A：WebView 官方登录页，扫码即登）。返回键浮在画面顶部，与其他页一致。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/login_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 单行页头浮在顶部：返回箭头兼热区 + 页名 + 时钟 -->
    <include
        layout="@layout/include_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />

    <!-- 加载小圆圈：预热 www.douyin.com / 打开登录页期间 WebView 是白屏，
         光靠顶部一行字看不出进度（2026-09-27 加；onPageFinished 时收掉） -->
    <include layout="@layout/include_loading" />

    <!-- 登录状态提示（拍照排障用） -->
    <TextView
        android:id="@+id/tv_login_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="34dp"
        android:background="@color/scrim"
        android:padding="@dimen/s3"
        android:text="正在打开登录页…"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_caption" />

</FrameLayout>
