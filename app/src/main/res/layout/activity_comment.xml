<?xml version="1.0" encoding="utf-8"?>
<!--
  视频评论页：收 = DOM 抓取，发 = 引擎注入。
  版式参考 BiliClient 的单行页头：原先 40dp 顶栏 + 常驻提示行 + 42dp 输入 + 文字按钮，
  光 chrome 就吃掉约 90dp；现在页头 22dp、提示行只在加载/空/失败时出现，省下的都换成评论内容。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <include layout="@layout/include_header" />

    <!-- 四态反馈：加载/空/失败时才占位，正常有内容就收起来，不常驻吃高度 -->
    <TextView
        android:id="@+id/tv_comment_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/s4"
        android:paddingVertical="@dimen/s2"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_caption"
        android:visibility="gone" />

    <com.dywatch.app.ui.RotaryScrollView
        android:id="@+id/sv_comments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_comments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/s3" />
    </com.dywatch.app.ui.RotaryScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/s3"
        android:paddingVertical="@dimen/s2">

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="0dp"
            android:layout_height="@dimen/ctrl_min"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:hint="说点什么…"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingHorizontal="@dimen/s5"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="@dimen/t_body" />

        <ImageButton
            android:id="@+id/btn_send_comment"
            android:layout_width="@dimen/ctrl_min"
            android:layout_height="@dimen/ctrl_min"
            android:layout_marginStart="@dimen/s2"
            android:background="@drawable/bg_pill"
            android:contentDescription="发送评论"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <!-- 关掉「评论自动续拉」时才露出的手动兜底 -->
    <Button
        android:id="@+id/btn_comments_more"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ctrl_min"
        android:layout_marginHorizontal="@dimen/s3"
        android:layout_marginBottom="@dimen/s2"
        android:background="@drawable/bg_settings_row"
        android:text="加载更多评论"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_body"
        android:visibility="gone" />
</LinearLayout>
