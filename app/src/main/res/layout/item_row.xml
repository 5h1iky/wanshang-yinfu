<?xml version="1.0" encoding="utf-8"?>
<!--
  通用列表行（评论 / 会话共用）。
  此前由 Rows.card() 在代码里 new 出来，没法进 RecyclerView 的 ViewHolder 复用；
  这里把同样的三段式画法搬成 XML：昵称（白·左·单行省略）/ 元信息（灰·右）/ 摘要（次级色·换行）。
  视觉必须与 Rows.card 一致，否则评论页和会话页的行样式会漂移。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/s5"
    android:paddingEnd="@dimen/s5"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="@dimen/s2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 昵称：单行 + 末尾省略（手表窄屏，长昵称不能把元信息挤出去） -->
        <com.dywatch.app.ui.MarqueeTextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/t_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/s2"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/t_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/t_body" />

</LinearLayout>
