<?xml version="1.0" encoding="utf-8"?>
<!--
  评论回复页：单行页头 + 固定原评论 + 回复分页列表 + 底部输入。
  回复读取只走原生只读接口；公开发送仍由 ChatEngine 的写动作完成。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <include layout="@layout/include_header" />

    <!-- 固定摘要：点这里回到回复原评论，同时取消已选的二级回复对象。 -->
    <LinearLayout
        android:id="@+id/root_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s3"
        android:layout_marginEnd="@dimen/s3"
        android:layout_marginBottom="@dimen/s2"
        android:background="@drawable/bg_settings_row"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s4"
        android:paddingTop="@dimen/s3"
        android:paddingBottom="@dimen/s3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.dywatch.app.ui.MarqueeTextView
                android:id="@+id/tv_root_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_root_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/s2"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/t_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_root_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s2"
            android:maxLines="4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/t_body" />

        <TextView
            android:id="@+id/tv_root_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s1"
            android:text="点原评论取消回复对象"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/t_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_reply_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/s4"
        android:paddingVertical="@dimen/s2"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_caption"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dywatch.app.ui.RotaryRecyclerView
            android:id="@+id/rv_replies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/s3"
            android:scrollbars="none" />

        <include layout="@layout/include_loading" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_reply_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="@dimen/s2"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/t_caption"
        android:visibility="gone" />

    <!-- 当前回复对象；×取消 与点原评论摘要效果一致。 -->
    <LinearLayout
        android:id="@+id/reply_target_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s3"
        android:layout_marginEnd="@dimen/s3"
        android:layout_marginBottom="@dimen/s1"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s2"
        android:visibility="gone">

        <com.dywatch.app.ui.MarqueeTextView
            android:id="@+id/tv_reply_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/t_body" />

        <TextView
            android:id="@+id/btn_cancel_reply"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/ctrl_min"
            android:layout_height="@dimen/ctrl_min"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="取消回复对象"
            android:gravity="center"
            android:text="×取消"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/t_caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/s3"
        android:paddingVertical="@dimen/s2">

        <EditText
            android:id="@+id/et_reply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:hint="回复原评论…"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:minHeight="@dimen/input_min_h"
            android:paddingStart="@dimen/s5"
            android:paddingEnd="@dimen/s5"
            android:paddingTop="@dimen/s2"
            android:paddingBottom="@dimen/s2"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="@dimen/t_body" />

        <ImageButton
            android:id="@+id/btn_send_reply"
            android:layout_width="@dimen/input_min_h"
            android:layout_height="@dimen/input_min_h"
            android:layout_marginStart="@dimen/s2"
            android:background="@drawable/bg_pill"
            android:contentDescription="发送回复"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_replies_more"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ctrl_min"
        android:layout_marginHorizontal="@dimen/s3"
        android:layout_marginBottom="@dimen/s2"
        android:background="@drawable/bg_settings_row"
        app:backgroundTint="@null"
        android:text="加载更多回复"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_body"
        android:visibility="gone" />
</LinearLayout>
