<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷回复条（手表输入层）：屏幕上打字对手表是最难受的输入方式，
  高频短语必须一键可发。聊天页与评论页共用这一份。

  2026-09-27 用户反馈"太占位置了"，改版：
    旧版 = 4 个等宽按钮铺满一行，每个 minHeight=42dp（还各占 1/4 宽度，
           手表 275dp 可用宽下每个只有 ~68dp，稍长的短语就被截断）。
    新版 = 一条 28dp 细胶囊条，按钮按内容宽度、横向可滚 ——
           纵向省下约 1/3，长短语也不再被挤断（横滑看全）。
  ⚠️ 想彻底不要它：设置里有「快捷回复条」开关，不必改布局。
  文案由代码 QuickReply.wire() 注入，所以这里不写死 text。
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_reply_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/s3"
    android:paddingEnd="@dimen/s3"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/qr1"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qr_height"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/s4"
            android:paddingEnd="@dimen/s4"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/qr_text" />

        <Button
            android:id="@+id/qr2"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qr_height"
            android:layout_marginStart="@dimen/s2"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/s4"
            android:paddingEnd="@dimen/s4"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/qr_text" />

        <Button
            android:id="@+id/qr3"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qr_height"
            android:layout_marginStart="@dimen/s2"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/s4"
            android:paddingEnd="@dimen/s4"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/qr_text" />

        <Button
            android:id="@+id/qr4"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qr_height"
            android:layout_marginStart="@dimen/s2"
            android:layout_marginEnd="@dimen/s2"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/s4"
            android:paddingEnd="@dimen/s4"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/qr_text" />
    </LinearLayout>
</HorizontalScrollView>
