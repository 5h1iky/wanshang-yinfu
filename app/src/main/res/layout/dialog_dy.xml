<?xml version="1.0" encoding="utf-8"?>
<!--
  自绘弹窗内容（2026-09-30 用户反馈：「怎么又用系统自带的那个了」）。
  一套语言：深色圆角卡、标题用正文亮白、正文次要色、按钮是胶囊（主=实底 / 次=描边）。
  ⚠️ 不引入品牌粉装饰——粉在本项目只允许三处（状态栏/进度条/点赞激活）。
  手表屏矮：正文区套 ScrollView，由 DyDialog 在代码里按屏高限高（超长公告可滚）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/s5"
    android:paddingEnd="@dimen/s5"
    android:paddingTop="@dimen/s4"
    android:paddingBottom="@dimen/s4">

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/t_title"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <ScrollView
        android:id="@+id/dlg_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s3"
        android:scrollbars="none">

        <TextView
            android:id="@+id/dlg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/t_body" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/dlg_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s4"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlg_btn_neg"
            style="@style/DyDialogButton.Ghost"
            android:layout_marginEnd="@dimen/s3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dlg_btn_pos"
            style="@style/DyDialogButton.Primary" />
    </LinearLayout>
</LinearLayout>
