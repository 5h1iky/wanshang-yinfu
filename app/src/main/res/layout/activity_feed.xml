<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.dywatch.app.widget.VerticalViewPager
        android:id="@+id/vvp"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      四态反馈：加载中 / 失败 / 没有更多。
      旧版只有"失败"和"没有更多"两态，首次进页面那几秒是纯黑屏，用户不知道是坏了还是在加载
      （真机首屏要等签名 + 拉流，手表上更久）。
    -->
    <TextView
        android:id="@+id/tv_feed_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/s4"
        android:paddingVertical="@dimen/s2"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_caption"
        android:visibility="gone" />

    <!-- 加载小圆圈：首屏要等签名+拉流（手表上更久），内容区正中给个在转的指示器，
         比只有顶部一行字更让人确信"它没死"（2026-09-27 用户提出） -->
    <include layout="@layout/include_loading" />

</FrameLayout>
