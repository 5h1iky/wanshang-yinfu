<?xml version="1.0" encoding="utf-8"?>
<!--
  TikTokController 的控制层（方案 D；2026-09-27 三修定稿）：
  底部一条 4dp 细进度条，宽度 70% 水平居中（运行时 TikTokController.onSizeChanged 设，
  XML 写不了父宽百分比）。粗细参照哔哩终端"刚刚好"的手感（其 AppCompat track≈2dp），
  再加一档到 4dp：AMOLED 上 2dp 太细容易被视频画面"吃掉"。
  ⚠️ 渲染与触控分离：SeekBar 本体只管画（4dp），拖动手感由 TikTokView 底部 48dp 热区负责
  ——SeekBar 高度不再承担触控职责，就不会被 Material 样式内边距挤没（上一版消失的根因）。
  交互不变：双击 ±10s / 拖动 seek / 单击暂停（全在 TikTokView）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SeekBar
        android:id="@+id/sb_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:background="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:minHeight="0dp"
        android:progressDrawable="@drawable/feed_seek_bar"
        android:splitTrack="false"
        android:thumb="@null"
        android:max="1000" />
</FrameLayout>
