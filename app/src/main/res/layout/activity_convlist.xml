<?xml version="1.0" encoding="utf-8"?>
<!-- 会话列表页：手表友好（大触控行 + 可见返回键，方案 §10） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- 单行页头：返回箭头兼热区 + 页名 + 时钟；页名由代码 setPageTitle 设置 -->
    <include layout="@layout/include_header" />

    <!-- 四态反馈：只在加载/空/失败时占位，有内容就收起来（照评论页的口径） -->
    <TextView
        android:id="@+id/tv_convlist_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/s4"
        android:paddingVertical="@dimen/s2"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_caption"
        android:visibility="gone" />

    <!-- 表冠可滚（默认关，设置里开）：与评论页共用同一份实现 -->
    <com.dywatch.app.ui.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_convs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/s3" />
    </com.dywatch.app.ui.RotaryScrollView>

</LinearLayout>
