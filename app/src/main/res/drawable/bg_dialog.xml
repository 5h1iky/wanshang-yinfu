<?xml version="1.0" encoding="utf-8"?>
<!--
  自绘弹窗的卡片底（2026-09-30）。视觉口径与「设置行」一致：
  深色圆角 + 1dp 中性描边，不用品牌粉（粉只允许出现在状态栏/进度条/点赞激活三处）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_dialog" />
    <corners android:radius="@dimen/r_control" />
    <stroke
        android:width="1dp"
        android:color="@color/bg_control" />
</shape>
