<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗主按钮：中性卡片底，按下时描边点亮（与设置行同款反馈逻辑，不铺粉色） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_control" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/accent_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/bg_control" />
        </shape>
    </item>
</selector>
