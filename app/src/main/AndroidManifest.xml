<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 手表声明。required=false：还要在手机上调试，写 true 会装不上测试机。 -->
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- 小屏/任意密度都要能吃下，圆屏方屏靠 values-round + 设置里的屏形开关适配 -->
    <supports-screens
        android:anyDensity="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <application
        android:name=".DyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dywatch">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M2 刷视频页（VerticalViewPager 上下滑 + 预加载） -->
        <activity
            android:name=".feed.FeedActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- M1 登录（架构 A：WebView 官方登录页，扫码即登） -->
        <activity
            android:name=".login.LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- M3 会话列表页（会话列表 → 选人 → 进会话） -->
        <activity
            android:name=".chat.ConvListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 视频评论页（收发评论，WebView 引擎复用） -->
        <activity
            android:name=".chat.CommentActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- M3 聊天页（自写极简三件套 + WebView JS 桥协议层） -->
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 「我的」页：喜欢（服务端只读）+ 看过（本地账本） -->
        <activity
            android:name=".ui.MineActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 作者主页：作品列表 + 用户信息（纯只读，原生 API 直连） -->
        <activity
            android:name=".ui.UserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 设置页：全局缩放 / 屏形 / 画质 / 常亮 / 清账本 / 诊断 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 关于页（方案 F）：应用身份 + GitHub/主页/协议/免责声明 -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />
    </application>

</manifest>
