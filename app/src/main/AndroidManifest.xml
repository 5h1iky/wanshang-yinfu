<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 手表声明。required=false：还要在手机上调试，写 true 会装不上测试机。 -->
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- 小屏/任意密度都要能吃下，圆屏方屏靠 values-round + 设置里的屏形开关适配 -->
    <supports-screens
        android:anyDensity="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <!--
        android:allowBackup="false"（2026-10-02，代码审计 H1）

        为什么必须关：应用把抖音会话 cookie 明文存在 SharedPreferences（dywatch_session），
        日志目录里还有私信/评论正文。而 allowBackup 默认 true 意味着这些会进
        adb backup / 云备份 / 换机迁移——README 与免责声明里写的
        "登录态仅保存在您本人的设备上""会话只存在设备本机"就成了假话：
        二手转卖、送修、借用时，接手的人能把会话原样恢复出来。
        dataExtractionRules 再显式排除一次（API 31+ 的口径），将来谁把 allowBackup 改回去也不会漏。

        ⚠️ 用户可感知的后果（要写进发布说明）：换设备/恢复备份不再带走登录态与本地账本，
        新设备需要重新扫码登录一次。同设备覆盖安装（同签名）不受影响，登录态照旧不丢。
    -->
    <application
        android:name=".DyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dywatch">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M2 刷视频页（VerticalViewPager 上下滑 + 预加载） -->
        <activity
            android:name=".feed.FeedActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- M1 登录（架构 A：WebView 官方登录页，扫码即登） -->
        <activity
            android:name=".login.LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- M3 会话列表页（会话列表 → 选人 → 进会话） -->
        <activity
            android:name=".chat.ConvListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 视频评论页（收发评论，WebView 引擎复用） -->
        <activity
            android:name=".chat.CommentActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- M3 聊天页（自写极简三件套 + WebView JS 桥协议层） -->
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 「我的」页：喜欢（服务端只读）+ 看过（本地账本） -->
        <activity
            android:name=".ui.MineActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 作者主页：作品列表 + 用户信息（纯只读，原生 API 直连） -->
        <activity
            android:name=".ui.UserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 设置页：全局缩放 / 屏形 / 画质 / 常亮 / 清账本 / 诊断 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 关于页（方案 F）：应用身份 + GitHub/主页/协议/免责声明 -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />
    </application>

</manifest>
